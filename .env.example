# Copy this file to .env. With Immich fill in IMMICH_URL and IMMICH_API_KEY; leave both empty to work with
# uploaded photos only. All other values are optional. Empty means "off".

# --- Immich (optional: both or neither) ---------------------------------------------
# Address of your Immich server as the container reaches it (not localhost: that is the container itself),
# e.g. http://192.0.2.10:2283
IMMICH_URL=
# Immich > Account settings > API keys. Permissions: see README ("Immich API key").
IMMICH_API_KEY=

# --- Login (strongly recommended) ----------------------------------------------------
# Without LOGIN_PASSWORD the app is open to everybody who can reach it.
LOGIN_USER=admin
LOGIN_PASSWORD=
LOGIN_NAME=

# --- Reverse proxy and shared links --------------------------------------------------
# Public base address of the shared links (port 8081), e.g. https://links.example.com/puzzles
SHARE_PUBLIC_URL=
# IP of your reverse proxy as the container sees it (comma-separated). Only then X-Real-IP / X-Forwarded-For count,
# so the login lockout sees the real visitor. Leave empty when the app is reached without a proxy.
TRUSTED_PROXIES=

# --- Ports and folders ---------------------------------------------------------------
PUZZLE_PORT=8080
PUZZLE_SHARE_PORT=8081
# Folder with your music library (read-only). Default ./music next to compose.yaml.
MUSIC_PATH=./music
TZ=Europe/Zurich

# --- Optional: family of Immich tools (shared login across subdomains) ---------------
FAMILY_ID=puzzle
FAMILY_SECRET=
# Parent domain for the shared login cookie, e.g. .example.com
FAMILY_COOKIE_DOMAIN=
SHARES_API_KEY=

# --- Optional: Umami statistics (your own instance; leave empty to count nothing) ----
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_LINKS_ID=
